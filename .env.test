# =============================================================================
# Test environment for integration tests (docker-compose.test.yml)
# Fully isolated from dev: separate Postgres container + separate database.
# =============================================================================

# --- Flask app ---
APP_NAME=choras_test
APP_ENV=testing

# Settings module used at import time (app/__init__.py) AND by the test base
# class (tests/unit/__init__.py -> APP_TEST_SETTINGS_MODULE). Both point to the
# TestingConfigs class, which reads SQLALCHEMY_DATABASE_URI from DATABASE_URL.
APP_SETTINGS_MODULE=config.TestingConfigs
APP_TEST_SETTINGS_MODULE=config.TestingConfigs

# --- Isolated test database ---
# Points at the dedicated db-test service (NOT the dev db_service). Separate
# container, separate database name, so dev data is never touched.
DATABASE_URL=postgresql://test_user:test_pass@db-test:5432/choras_test
DATABASE=postgres
BBDD_HOST=db-test
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_pass
POSTGRES_DB=choras_test

# --- Secrets (dummy values, tests only) ---
SECRET_KEY=test-secret-key
JWT_SECRET_KEY=test-jwt-secret

# --- URL building (file_service builds upload URLs from these) ---
FLASK_RUN_HOST=backend-test
FLASK_RUN_PORT=5001

# --- Simulation backend paths (mounted into the container) ---
SETTINGS_FILE_FOLDER=/app/simulation-backend/example_settings
METHODS_CONFIG_PATH=/app/simulation-backend/methods-config.json
